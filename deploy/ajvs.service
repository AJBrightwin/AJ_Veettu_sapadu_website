# /etc/systemd/system/ajvs.service  — runs the Django backend with Gunicorn
[Unit]
Description=AJ Veettu Saapadu website (Django + Gunicorn)
After=network.target mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ajvs/backend
ExecStart=/var/www/ajvs/venv/bin/gunicorn AJ_cloud.wsgi:application --workers 3 --timeout 60 --bind unix:/run/ajvs/ajvs.sock
RuntimeDirectory=ajvs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
